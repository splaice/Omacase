# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor/runtime junk
*.swp
*~

# omacase runtime state (lives in ~/.local/state/omacase, not the repo, but
# guard against accidental local copies)
state/
*.local

# Theme caches that used to land inside a public checkout when OMACASE_DATA
# and the git prefix were the same path (issue #7).
generated/
backgrounds/
upstream/

# Python bytecode (e.g. lib/palette.py compile artifacts)
__pycache__/
*.pyc
