#!/bin/bash
# omacase — single command to install, configure, theme, and manage an
# opinionated tiling macOS. Subcommands live in lib/*.sh.
set -euo pipefail

# Resolve the repo root regardless of how we were invoked (symlink-safe).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
OMACASE_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export OMACASE_ROOT

source "$OMACASE_ROOT/lib/common.sh"

usage() {
  cat <<'EOF'
Omacase — opinionated tiling macOS, managed from one command

usage: omacase <command> [args]

  install            Full idempotent setup (re-runnable)
  update             git pull + brew bundle + re-apply dotfiles & defaults + migrations
  outdated           Print the count of outdated Homebrew packages
  migrate            Apply pending one-time migrations (also run by update)
  theme [name]       Apply a theme everywhere (no name = list/pick)
  palette [name]     Edit a theme's Ghostty ANSI palette in a TUI with a live eza preview (no name = active theme)
  wallpaper [...]    Pick the active theme's background: list|next|prev|pick|<n> (alias: wp)
  webapp [name]      Open an Omarchy web app (no name = list)
  appearance [...]   Toggle/set macOS Light/Dark (toggle|dark|light)
  wm [menu|palette|settings]  Start OmniWM and verify it; menu/palette/settings open its app menu / command palette / settings window
  terminal [cmd...]  Open a new Ghostty window in the running instance, optionally running cmd (alias: term)
  files              Toggle a centered yazi file-manager popup
  browser            Open/focus the system default browser
  music [spotify|apple]  Toggle a centered music overlay
  obsidian           Toggle a centered Obsidian overlay
  1password          Toggle a centered 1Password overlay (alias: 1pw)
  message            Toggle a centered iMessage overlay at 80% (alias: messages)
  todoist            Toggle a centered Todoist overlay
  usage [update|json]  Agent usage dashboard — token burn + plan limits (Claude, Codex, Grok)
  keybinds           Display the OmniWM and Omacase key reference
  doctor             Check permissions and missing grants
  backup [label]     Snapshot current dotfiles & macOS defaults
  restore [id]       Roll back to a snapshot (--list to see them)
  extras [name]      Optional opt-in tweaks (list | sudo-touchid [on|off|status] | mole [args])
  config             Open the config directory
  menu               Interactive TUI
  notify [...]       Pop a native macOS notification (--title/--subtitle/--sound/--image) for scripts/keybinds
  version            Print version
  uninstall          Remove omacase-managed config (keeps your apps)

Run `omacase doctor` after install to grant Accessibility permissions.
EOF
}

cmd="${1:-menu}"; shift || true
case "$cmd" in
  install)        source "$OMACASE_ROOT/lib/install.sh";  omacase_install "$@" ;;
  update)         source "$OMACASE_ROOT/lib/update.sh";   omacase_update  "$@" ;;
  outdated)       source "$OMACASE_ROOT/lib/update.sh";   omacase_outdated "$@" ;;
  migrate)        source "$OMACASE_ROOT/lib/migrate.sh";  omacase_migrate "$@" ;;
  theme)          source "$OMACASE_ROOT/lib/theme.sh";    omacase_theme   "$@" ;;
  palette)        source "$OMACASE_ROOT/lib/palette.sh";  omacase_palette "$@" ;;
  wallpaper|wp)   source "$OMACASE_ROOT/lib/theme.sh";    omacase_wallpaper "$@" ;;
  webapp)         source "$OMACASE_ROOT/lib/actions.sh";  omacase_webapp     "$@" ;;
  appearance)     source "$OMACASE_ROOT/lib/actions.sh";  omacase_appearance "$@" ;;
  wm)             source "$OMACASE_ROOT/lib/wm.sh";       omacase_wm      "$@" ;;
  terminal|term)  source "$OMACASE_ROOT/lib/wm.sh";       omacase_terminal  "$@" ;;
  files)          source "$OMACASE_ROOT/lib/wm.sh";       omacase_files     "$@" ;;
  notify)         source "$OMACASE_ROOT/lib/notify.sh";   omacase_notify    "$@" ;;
  browser)        source "$OMACASE_ROOT/lib/wm.sh";       omacase_browser   "$@" ;;
  music)          source "$OMACASE_ROOT/lib/wm.sh";       omacase_music     "$@" ;;
  obsidian)       source "$OMACASE_ROOT/lib/wm.sh";       omacase_obsidian  "$@" ;;
  1password|1pw)  source "$OMACASE_ROOT/lib/wm.sh";       omacase_1password "$@" ;;
  message|messages) source "$OMACASE_ROOT/lib/wm.sh";     omacase_message   "$@" ;;
  todoist)        source "$OMACASE_ROOT/lib/wm.sh";       omacase_todoist   "$@" ;;
  usage)          source "$OMACASE_ROOT/lib/usage.sh";    omacase_usage   "$@" ;;
  keybinds)       source "$OMACASE_ROOT/lib/keybinds.sh"; omacase_keybinds  "$@" ;;
  doctor)         source "$OMACASE_ROOT/lib/doctor.sh";   omacase_doctor  "$@" ;;
  backup)         source "$OMACASE_ROOT/lib/backup.sh";   omacase_backup  "$@" ;;
  restore)        source "$OMACASE_ROOT/lib/backup.sh";   omacase_restore "$@" ;;
  extras)         source "$OMACASE_ROOT/lib/extras.sh";   omacase_extras  "$@" ;;
  menu)           source "$OMACASE_ROOT/lib/menu.sh";     omacase_menu    "$@" ;;
  config)         exec sh -c 'exec ${EDITOR:-open} "$1"' sh "$OMACASE_ROOT/home" ;;   # sh splits multi-word EDITORs like "code -w"
  version|-v|--version) cat "$OMACASE_ROOT/VERSION" ;;
  uninstall)      source "$OMACASE_ROOT/lib/install.sh";  omacase_uninstall "$@" ;;
  help|-h|--help) usage ;;
  *) error "unknown command: $cmd"; echo; usage; exit 1 ;;
esac
