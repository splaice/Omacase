# omacase Ghostty config. Theme is swapped by `omacase theme` via the
# config-file include below. Omarchy-derived themes are generated into
# ~/.local/share/omacase/generated/themes/<name>/ghostty.
# IoskeleyMono (Term + Nerd Font build) is installed by `omacase install` from
# a pinned release (lib/fonts.sh). Ghostty treats repeated font-family lines as
# a fallback chain: JetBrains Mono covers the moments before the font lands and
# any glyph it lacks.
font-family = "IoskeleyMonoTerm Nerd Font Mono"
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

window-padding-x = 10
window-padding-y = 10
# OmniWM requires standard macOS window controls to classify and tile Ghostty.
window-decoration = true
macos-titlebar-style = transparent
background-opacity = 0.97
mouse-hide-while-typing = true
copy-on-select = clipboard

# Theme is managed by omacase (symlink → ~/.config/ghostty/theme).
# Must be absolute: `config` is symlinked into the repo, so a relative
# path would resolve against the repo dir, not ~/.config/ghostty.
config-file = ~/.config/ghostty/theme
