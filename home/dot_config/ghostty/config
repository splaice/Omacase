# omacase Ghostty config. Theme is swapped by `omacase theme` via the
# config-file include below. Omarchy-derived themes are generated into
# ~/.local/share/omacase/generated/themes/<name>/ghostty.
# Fonts come from the Brewfile. Ghostty treats repeated font-family lines as a
# fallback chain, tried in order for each glyph:
#   Maple Mono NF     main face + Nerd Font icons (starship, nvim, eza)
#   JuliaMono         fills in the symbols Maple lacks (math, box, arrows, scripts)
#   Noto Color Emoji  emoji (Ghostty picks the color face for emoji presentation)
font-family = "Maple Mono NF"
font-family = "JuliaMono"
font-family = "Noto Color Emoji"
font-size = 14
font-thicken = true

window-padding-x = 10
window-padding-y = 10
# OmniWM requires standard macOS window controls to classify and tile Ghostty.
window-decoration = true
macos-titlebar-style = transparent
background-opacity = 0.97
mouse-hide-while-typing = true
copy-on-select = clipboard

# Theme is managed by omacase (symlink → ~/.config/ghostty/theme).
# Must be absolute: `config` is symlinked into the repo, so a relative
# path would resolve against the repo dir, not ~/.config/ghostty.
config-file = ~/.config/ghostty/theme
