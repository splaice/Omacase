<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.omacase.omniwm</string>
  <!-- Attribute this item to OmniWM in System Settings → Login Items; without
       it the pane shows the bare executable name, "open". -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.barut.OmniWM</string>
  </array>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>OmniWM</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
