#compdef omacase
# Tab completion for `omacase`. `omacase install` links this file into
# Homebrew's share/zsh/site-functions (already on fpath via `brew shellenv`,
# wired live by compinit in the managed ~/.zshrc); `omacase doctor` repairs the
# link. Dynamic values — themes, web apps, snapshots — are read from the repo
# and state dirs at completion time, so they never drift from the CLI.

_omacase() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C \
    '1:command:->command' \
    '*::argument:->argument' && ret=0

  # Repo root, resolved through the bin symlink (works from any install path).
  local root=${commands[omacase]:A:h:h}

  case $state in
    command)
      local -a subcommands=(
        'install:full idempotent setup (re-runnable)'
        'update:git pull + brew bundle + re-apply dotfiles & defaults'
        'migrate:apply pending one-time migrations (also run by update)'
        'outdated:print the count of outdated Homebrew packages'
        'theme:apply a theme everywhere (no name = list/pick)'
        'palette:edit a theme Ghostty ANSI palette in a TUI with a live eza preview'
        'wallpaper:pick the active theme background (list|next|prev|<n>)'
        'wp:pick the active theme background (list|next|prev|<n>)'
        'webapp:open an Omarchy web app (no name = list)'
        'appearance:toggle/set macOS Light/Dark'
        'wm:start/verify OmniWM; menu|palette|settings open its app menu / command palette / settings window'
        'terminal:open a new Ghostty window in the running instance'
        'term:open a new Ghostty window in the running instance'
        'files:toggle a centered ranger file-manager popup'
        'browser:open/focus the system default browser'
        'music:toggle a centered music overlay'
        'obsidian:toggle a centered Obsidian overlay'
        '1password:toggle a centered 1Password overlay'
        '1pw:toggle a centered 1Password overlay'
        'message:toggle a centered iMessage overlay'
        'messages:toggle a centered iMessage overlay'
        'todoist:toggle a centered Todoist overlay'
        'keybinds:display the OmniWM and Omacase key reference'
        'doctor:check permissions and missing grants'
        'backup:snapshot current dotfiles & macOS defaults'
        'restore:roll back to a snapshot (--list to see them)'
        'extras:optional opt-in tweaks (list | sudo-touchid)'
        'config:open the config directory'
        'menu:interactive TUI'
        'notify:pop a native macOS notification (for scripts/keybinds)'
        'version:print version'
        'uninstall:remove omacase-managed config (keeps your apps)'
        'help:show usage'
      )
      _describe -t commands 'omacase command' subcommands && ret=0
      ;;
    argument)
      case $line[1] in
        theme|palette)
          local -a themes=( ${(f)"$(awk -F'|' '$0 !~ /^#/ && NF >= 5 { print $1 }' $root/themes/manifest 2>/dev/null)"} )
          _describe -t themes 'theme' themes && ret=0
          ;;
        webapp)
          # Source of truth: the _webapp_names list in lib/actions.sh.
          local -a apps=( ${(z)"$(sed -n 's/^_webapp_names="\(.*\)"/\1/p' $root/lib/actions.sh 2>/dev/null)"} list )
          _describe -t webapps 'web app' apps && ret=0
          ;;
        appearance)
          _values 'appearance' toggle dark light && ret=0
          ;;
        wallpaper|wp)
          _values 'wallpaper' list next prev pick && ret=0
          ;;
        music)
          _values 'music app' spotify apple && ret=0
          ;;
        wm)
          _values 'wm action' 'menu[open the OmniWM app menu]' 'palette[open the OmniWM command palette]' 'settings[open the OmniWM settings window]' && ret=0
          ;;
        restore)
          local backups=${OMACASE_STATE:-$HOME/.local/state/omacase}/backups
          local -a snapshots=( $backups/*(N/:t) ) flags=( '--list:list snapshots' )
          _describe -t snapshots 'snapshot' snapshots -- flags && ret=0
          ;;
        extras)
          if (( CURRENT == 2 )); then
            _values 'extra' 'list[list extras and their state]' \
              'sudo-touchid[Touch ID for sudo + longer shared credential cache]' \
              'clean[deep-clean caches and app leftovers via mole]' && ret=0
          elif [ "$line[2]" = clean ]; then
            _values 'option' '--dry-run[preview without deleting]' '--whitelist[manage protected paths]' && ret=0
          else
            _values 'action' 'on[enable]' 'off[revert]' 'status[show current state]' && ret=0
          fi
          ;;
      esac
      ;;
  esac

  return ret
}

_omacase "$@"
